<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Файловая система и программное обеспечение — учебник-тренажёр, 6 класс</title>
<style>
:root{
  --navy:#2F6F94; --deep:#1F5878; --mid:#5D94B5; --sky:#D8E9F3; --ink:#25394A; --paper:#F2F7FA; --panel:#FFFFFF; --line:#B9CEDC; --soft:#E3F0F7; --sage:#7DB59A;
  --blue:#2F6F94; --yel:#F2C14E; --yelbg:#FFEFC2; --muted:#55697A;
  --ok:#23734A; --okbg:#E4F4EA; --bad:#B14A3F; --badbg:#FBE9E6;
  --mono:'JetBrains Mono',Consolas,'Courier New',monospace;
}
*{box-sizing:border-box}
html{font-size:21px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Times New Roman',Times,serif;line-height:1.45}
button,input{font:inherit;color:inherit}
.mono{font-family:var(--mono);font-size:.93em}
svg.ic{width:1.5em;height:1.25em;flex:none;vertical-align:middle}
svg.ic.file{width:1.15em;height:1.3em}

/* окно «Проводника» */
.win{max-width:1320px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column;background:var(--panel);border-left:2px solid var(--line);border-right:2px solid var(--line)}
.titlebar{background:var(--sky);color:var(--ink);border-bottom:2px solid var(--line);padding:.6rem 1.1rem;display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;align-items:center}
.titlebar h1{font-size:1.25rem;margin:0;font-weight:700;flex:1 1 20rem;display:flex;gap:.6rem;align-items:center}
.who{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}
.who label{display:flex;gap:.4rem;align-items:center;font-weight:700}
.who input{background:#fff;color:var(--ink);border:3px solid var(--mid);border-radius:6px;padding:.25rem .5rem}
#fio{width:15rem} #cls{width:4.5rem}
.who input.need{border-color:var(--bad);box-shadow:0 0 0 4px rgba(177,74,63,.3)}
.addr{display:flex;align-items:center;gap:.6rem;padding:.45rem 1.1rem;background:#F8FBFD;border-bottom:2px solid var(--line)}
.addr .path{flex:1;font-family:var(--mono);font-size:.9rem;font-weight:700;background:#fff;border:2px solid var(--line);border-radius:6px;padding:.3rem .7rem;overflow-wrap:anywhere}
.addr .path b{color:var(--blue)}
.body{flex:1;display:grid;grid-template-columns:17rem 1fr}
nav{border-right:2px solid var(--line);background:#F8FBFD;padding:.8rem .6rem}
nav .root{font-family:var(--mono);font-weight:700;font-size:.9rem;display:flex;gap:.4rem;align-items:center;padding:.2rem .4rem .5rem}
nav button{display:flex;width:100%;align-items:center;gap:.5rem;text-align:left;background:none;border:2px solid transparent;border-radius:8px;padding:.45rem .5rem;margin:.15rem 0;cursor:pointer;font-size:1rem;line-height:1.2}
nav button:hover{background:var(--soft)}
nav button.on{background:var(--soft);border-color:var(--blue);font-weight:700}
nav button .nm{flex:1}
nav .badge{font-family:var(--mono);font-size:.8rem;font-weight:700;border-radius:999px;padding:.1rem .5rem;background:#E6EEF3;color:var(--muted);white-space:nowrap}
nav .badge.done{background:var(--navy);color:#fff}
nav hr{border:0;border-top:2px solid var(--line);margin:.6rem .2rem}
main{padding:1.1rem 1.6rem 3rem;min-width:0}
h2{font-size:1.75rem;line-height:1.15;margin:.1rem 0 .7rem}
h3{font-size:1.25rem;margin:1.2rem 0 .4rem}
p{margin:.5rem 0}
:focus-visible{outline:4px solid #E8A33A;outline-offset:2px}

/* вкладки «Читаю / Выполняю» */
.tabs{display:flex;gap:.4rem;border-bottom:3px solid var(--navy);margin-bottom:1rem}
.tabs button{display:flex;gap:.45rem;align-items:center;border:2px solid var(--line);border-bottom:none;border-radius:10px 10px 0 0;background:#F1F6F9;padding:.45rem 1.1rem;cursor:pointer;font-weight:700;font-size:1.05rem}
.tabs button.on{background:var(--navy);color:#fff;border-color:var(--navy)}

/* теория */
.theory{max-width:56rem}
.def{background:var(--soft);color:var(--ink);border-left:8px solid var(--mid);border-radius:0 12px 12px 0;padding:.8rem 1.1rem;font-size:1.15rem;margin:.7rem 0}
.def b{color:var(--deep)}
.note{border-left:8px solid var(--yel);background:#FFF8E3;padding:.6rem 1rem;border-radius:0 10px 10px 0;margin:.8rem 0}
.cards{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));margin:.7rem 0}
.card{border:2px solid var(--line);border-radius:12px;padding:.7rem .9rem;background:#fff}
.card h4{margin:0 0 .3rem;font-size:1.15rem}
.card.sys{border-top:10px solid var(--mid)} .card.app{border-top:10px solid var(--yel)} .card.dev{border-top:10px solid var(--sage)}
.card ul,.theory ul{margin:.3rem 0;padding-left:1.2rem}
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:.4rem 0}
.chip{background:var(--soft);border-radius:8px;padding:.2rem .7rem;font-weight:700}
.keys{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0}
.keys span{font-family:var(--mono);font-weight:700;font-size:1.25rem;min-width:2rem;text-align:center;background:var(--badbg);color:var(--bad);border:2px solid var(--bad);border-radius:8px;padding:.1rem .3rem}
.anat{display:flex;flex-wrap:wrap;align-items:flex-start;gap:.3rem .9rem;margin:.8rem 0;font-family:var(--mono);font-weight:700;font-size:1.5rem}
.anat div{display:flex;flex-direction:column;align-items:center;gap:.3rem}
.anat .box{padding:.3rem .7rem;border-radius:10px}
.anat .n{background:var(--soft)} .anat .e{background:var(--yelbg)} .anat .d{background:#E6EEF3}
.anat small{max-width:11rem;text-align:center;line-height:1.15;font-family:'Times New Roman',serif;font-size:.9rem;font-weight:700;color:var(--muted)}
.anat .sep{padding:.3rem 0;color:var(--bad)}
table{border-collapse:collapse;width:100%;margin:.6rem 0}
th,td{border:2px solid var(--line);padding:.4rem .7rem;text-align:left;vertical-align:top}
th{background:var(--sky);color:var(--ink)}
tr:nth-child(even) td{background:#F6FAFC}
.flow{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin:.8rem 0;font-weight:700}
.flow .b{border:2px solid var(--mid);border-radius:10px;padding:.5rem .9rem;background:#fff;text-align:center}
.flow .b.os{background:var(--sky);color:var(--ink)}
.flow .ar{font-size:1.5rem;color:var(--blue)}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(17rem,1fr));gap:.8rem}
.yes h4{color:var(--ok)} .no h4{color:var(--bad)}
.go{margin-top:1.2rem}

/* дерево папок */
.tree{font-family:var(--mono);font-size:.95rem;font-weight:700;border:2px solid var(--line);border-radius:12px;padding:.7rem 1rem;background:#fff;display:inline-block;min-width:19rem}
.tree .r{display:flex;gap:.45rem;align-items:center;padding:.12rem 0}
.icons{display:flex;gap:2rem;flex-wrap:wrap;margin:.6rem 0}
.icons figure{margin:0;text-align:center;font-weight:700}
.icons svg{width:5rem;height:5.7rem;display:block;margin:0 auto .2rem}

/* кнопки */
.btn{background:var(--blue);color:#fff;border:0;border-radius:10px;padding:.55rem 1.3rem;font-weight:700;font-size:1.05rem;cursor:pointer}
.btn:hover{background:#25597A}
.btn.sec{background:#fff;color:var(--deep);border:2px solid var(--mid)}
.btn.sec:hover{background:var(--soft)}

/* задания */
.prac{max-width:54rem}
.bar{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:.8rem}
.bar .cnt{font-weight:700;font-size:1.1rem}
.dots{display:flex;gap:.3rem}
.dots i{width:1.15rem;height:1.15rem;border-radius:50%;border:2px solid var(--line);background:#fff;display:block}
.dots i.ok{background:var(--ok);border-color:var(--ok)} .dots i.bad{background:var(--bad);border-color:var(--bad)} .dots i.cur{border-color:var(--mid);border-width:4px}
.task{border:2px solid var(--line);border-radius:14px;padding:1rem 1.2rem;background:#fff}
.q{font-size:1.25rem;font-weight:700;margin:0 0 .8rem}
.q .mono{background:var(--soft);border-radius:6px;padding:.05rem .4rem;white-space:pre-wrap}
.big{font-family:var(--mono);font-weight:700;font-size:1.55rem;background:var(--soft);border-radius:10px;padding:.5rem .9rem;display:inline-flex;gap:.6rem;align-items:center;margin:.1rem 0 .9rem;white-space:pre-wrap}
.opts{display:grid;gap:.6rem;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr))}
.opts.col{grid-template-columns:1fr}
.opt{display:flex;gap:.5rem;align-items:center;text-align:left;background:#fff;border:3px solid var(--mid);border-radius:10px;padding:.6rem .9rem;cursor:pointer;font-size:1.1rem;font-weight:700;min-height:3.2rem}
.opt:hover:not(:disabled){background:var(--soft)}
.opt.m{font-family:var(--mono);font-size:1rem;white-space:pre-wrap;overflow-wrap:anywhere}
.opt:disabled{cursor:default;opacity:.75}
.opt.right{background:var(--okbg);border-color:var(--ok);color:var(--ok);opacity:1}
.opt.wrong{background:var(--badbg);border-color:var(--bad);color:var(--bad);opacity:1}
.opt .mark{margin-left:auto;font-size:1.3rem}
.side{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;align-items:start}
.side .opts{align-content:start}
@media (max-width:860px){.side{grid-template-columns:1fr}}
.inp{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center}
.inp input{flex:1 1 18rem;font-family:var(--mono);font-size:1.15rem;font-weight:700;border:3px solid var(--mid);border-radius:10px;padding:.5rem .8rem;min-width:0}
.fb{margin-top:.9rem;border-radius:10px;padding:.7rem 1rem;font-size:1.1rem}
.fb.ok{background:var(--okbg);border:2px solid var(--ok)} .fb.bad{background:var(--badbg);border:2px solid var(--bad)}
.fb b.h{font-size:1.2rem}
.fb.ok b.h{color:var(--ok)} .fb.bad b.h{color:var(--bad)}
.next{margin-top:.9rem}
.result{text-align:center;padding:1.2rem}
.score{font-size:3.4rem;font-weight:700;line-height:1;color:var(--deep);margin:.4rem 0}
.score small{font-size:1.4rem}
.miss{text-align:left;margin:1rem auto 0;max-width:46rem}
.miss li{margin:.4rem 0}
.rowbtn{display:flex;gap:.7rem;justify-content:center;flex-wrap:wrap;margin-top:1.1rem}
.total{font-size:1.3rem;font-weight:700;background:var(--soft);color:var(--ink);border:2px solid var(--mid);border-radius:12px;padding:.7rem 1.1rem;margin:.8rem 0}
.total b{color:var(--deep);font-size:1.6rem}
.warn{color:var(--bad);font-weight:700;margin:.5rem 0}
.hide{display:none!important}
@media (max-width:860px){.body{grid-template-columns:1fr} nav{border-right:0;border-bottom:2px solid var(--line)}}
@media print{nav,.addr,.tabs,.btn{display:none}}

/* --- новые типы заданий --- */
.chars{display:flex;flex-wrap:wrap;gap:.25rem;margin:.1rem 0 .4rem}
.chars button{font-family:var(--mono);font-weight:700;font-size:1.5rem;min-width:2.2rem;height:3rem;padding:0 .3rem;border:3px solid var(--mid);border-radius:8px;background:#fff;cursor:pointer}
.chars button.sp{min-width:1.1rem;border-color:transparent;background:none;cursor:default}
.chars button:hover:not(:disabled){background:var(--soft)}
.chars button:disabled{cursor:default;color:var(--ink)}
.chars button.right{background:var(--okbg);border-color:var(--ok);color:var(--ok)}
.chars button.wrong{background:var(--badbg);border-color:var(--bad);color:var(--bad)}
.opts.multi .box{font-size:1.4rem;line-height:1;flex:none}
.opt.sel{background:var(--soft);border-color:var(--navy)}
.opt .mark.sm{font-size:.85rem;font-weight:400;font-family:'Times New Roman',serif}
.pathline{font-family:var(--mono);font-weight:700;font-size:1.15rem;min-height:3.1rem;border:3px dashed var(--mid);border-radius:10px;padding:.55rem .8rem;margin-bottom:.7rem;background:#fff;overflow-wrap:anywhere}
.pathline .ph{font-family:'Times New Roman',serif;font-weight:400;color:var(--muted)}
.pathline.ok{border:3px solid var(--ok);background:var(--okbg);color:var(--ok)} .pathline.bad{border:3px solid var(--bad);background:var(--badbg);color:var(--bad)}
.pieces{display:flex;flex-wrap:wrap;gap:.5rem}
.pieces .opt{min-height:2.8rem;padding:.4rem .9rem}
.pieces .opt:disabled{opacity:.35}
.rowl{display:flex;gap:.6rem;flex-wrap:wrap}
.tree button.r{display:flex;width:100%;gap:.45rem;align-items:center;text-align:left;font:inherit;color:inherit;background:none;border:2px solid transparent;border-radius:8px;padding-top:.12rem;padding-bottom:.12rem;padding-right:.5rem;cursor:pointer}
.tree button.r:hover:not(:disabled){background:var(--soft);border-color:var(--mid)}
.tree button.r:disabled{cursor:default}
.tree button.r.right{background:var(--okbg);border-color:var(--ok);color:var(--ok)} .tree button.r.wrong{background:var(--badbg);border-color:var(--bad);color:var(--bad)}
.tree .mark{margin-left:auto;padding-left:.8rem}
.sub{font-size:1.1rem;color:var(--muted);margin:-.5rem 0 .9rem}
td.mono{white-space:nowrap}
/* --- справочник программ --- */
.rsec{border:2px solid var(--line);border-radius:12px;padding:.2rem 1rem .6rem;margin:1rem 0;background:#fff}
.rsec.sys{border-top:10px solid var(--mid)} .rsec.app{border-top:10px solid var(--yel)} .rsec.dev{border-top:10px solid var(--sage)}
.rsec h3{font-size:1.35rem;margin:.6rem 0 .2rem}
.rsec h3 span{font-size:1rem;font-weight:400;color:var(--muted);margin-left:.4rem}
.rsec h4{font-size:1.05rem;margin:.9rem 0 .25rem;color:var(--deep)}
.plist{display:grid;grid-template-columns:13rem 1fr;gap:.1rem 1rem;margin:0}
.plist dt{font-weight:700} .plist dd{margin:0}
.etc{margin:.1rem 0 0;color:var(--muted)}
@media (max-width:700px){.plist{grid-template-columns:1fr} .plist dd{margin-bottom:.35rem}}
</style>
</head>

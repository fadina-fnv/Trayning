  let h = '<div class="prac"><div class="bar"><span class="cnt">Задание ' + (s.i + 1) + ' из ' + TOTAL + '</span>' + dotsHTML(s) + '<span class="cnt">Верно: ' + s.score + '</span></div><div class="task"><p class="q">' + t.q + '</p>';
  if(t.side) h += '<div class="side"><div>' + t.extra + '</div><div>' + bodyHTML(t, s) + '</div></div>';
  else h += (t.extra || '') + (t.big ? '<div><span class="big">' + t.big + '</span></div>' : '') + (t.sub ? '<p class="sub">' + esc(t.sub) + '</p>' : '') + bodyHTML(t, s);
  if(s.answered){
    h += '<div class="fb ' + (s.fb.ok ? 'ok' : 'bad') + '" role="status"><b class="h">' + (s.fb.ok ? '✔ Верно!' : '✘ Неверно.') + '</b> ' + s.fb.msg + '</div>';
    h += '<div class="next"><button type="button" class="btn" data-next="1" id="nextbtn">' + (s.i + 1 < TOTAL ? 'Следующее задание' : 'Посмотреть результат') + '</button></div>';
  }
  return h + '</div></div>';
}
function verdict(n){ return n >= 9 ? 'Отлично! Ты хорошо разобрался в теме.' : n >= 7 ? 'Хорошо! Посмотри ошибки и попробуй ещё раз.' : n >= 5 ? 'Неплохо, но тему стоит повторить. Загляни во вкладку «Читаю».' : 'Перечитай объяснение во вкладке «Читаю» и попробуй снова — задания будут новые.'; }
function resultHTML(c, s){
  let h = '<div class="prac"><div class="task result"><h2>' + c.n + '. ' + c.title + '</h2><div class="score">' + s.score + '<small> из 10</small></div>' + dotsHTML(s).replace('class="dots"','class="dots" style="justify-content:center"') + '<p style="font-size:1.2rem;font-weight:700">' + verdict(s.score) + '</p>';
  const miss = s.log.filter(x => !x.ok);
  if(miss.length){ h += '<div class="miss"><b>Разбор ошибок:</b><ol>'; miss.forEach(x => { h += '<li>' + esc(x.q) + '<br>Твой ответ: <b>' + esc(x.given) + '</b>. Правильно: <b>' + esc(x.right) + '</b></li>'; }); h += '</ol></div>'; }
  const idx = CH.indexOf(c), nxt = idx + 1 < CH.length ? CH[idx + 1].id : 'sum';
  h += '<div class="rowbtn"><button type="button" class="btn sec" data-again="1">Ещё раз — новые задания</button><button type="button" class="btn" data-go="' + nxt + '">' + (nxt === 'sum' ? 'Мои результаты' : 'Следующий раздел') + '</button></div></div></div>';
  return h;
}
function totals(){ let sum = 0, done = 0; CH.forEach(c => { const b = S.res[c.id].best; if(b !== null){ sum += b; done++; } }); return {sum, done, mark:Math.round(sum / CH.length)}; }
function summaryHTML(){
  const t = totals();
  let h = '<h2>Мои результаты</h2><p>В каждом разделе 10 заданий. В таблице — последний и лучший результат. Чтобы пройти раздел ещё раз, нажми в конце раздела кнопку «Ещё раз — новые задания».</p><table><tr><th>Раздел</th><th>Сейчас</th><th>Попыток</th><th>Последний результат</th><th>Лучший результат</th></tr>';
  CH.forEach(c => { const r = S.res[c.id]; const ss = S.ses[c.id], now = !ss || (!ss.done && ss.i === 0 && !ss.answered) ? (r.attempts ? 'пройден' : 'не начат') : ss.done ? 'пройден' : 'выполнено ' + (ss.i + (ss.answered ? 1 : 0)) + ' из 10'; h += '<tr><td>' + c.n + '. ' + c.title + '</td><td>' + now + '</td><td>' + r.attempts + '</td><td>' + (r.last === null ? '—' : r.last + ' из 10') + '</td><td><b>' + (r.best === null ? '—' : r.best + ' из 10') + '</b></td></tr>'; });
  h += '</table><div class="total">Пройдено разделов: ' + t.done + ' из ' + CH.length + '. Сумма лучших результатов: ' + t.sum + ' из 50. Итог: <b>' + t.mark + '</b> из 10</div>';
  h += '<p id="warn" class="warn hide">Сначала впиши вверху страницы фамилию, имя и класс.</p><div class="rowbtn" style="justify-content:flex-start"><button type="button" class="btn" data-save="1">Сохранить отчёт в файл .txt</button></div><p>Отчёт сохранится в папку «Загрузки». Посмотри на имя файла: оно составлено по правилам, которые ты изучил.</p>';
  return h;
}

/* ================= ДЕЙСТВИЯ ================= */
function answer(t, s, ok, given, right, msg, more){
  s.answered = true; s.marks[s.i] = ok; if(ok) s.score++;
  s.fb = Object.assign({ok, msg, given}, more || {});
  s.log.push({q:plain(t.q) + (t.extra && !t.side ? ' ' + plain(t.extra) : '') + (t.big ? ' ' + plain(t.big) : '') + (t.name ? ' ' + t.name : ''), given, right, ok});
  render(); const nb = $('nextbtn'); if(nb) nb.focus();
}
function finish(id){ const s = S.ses[id], r = S.res[id]; s.done = true; r.attempts++; r.last = s.score; r.best = r.best === null ? s.score : Math.max(r.best, s.score); r.mistakes = s.log.filter(x => !x.ok); }
function check(){
  const s = S.ses[S.cur], t = s.tasks[s.i]; if(s.answered) return;
  if(t.type === 'input'){ const el = $('ans'), v = el.value; if(!v.trim()){ el.focus(); return; } const r = t.check(v); answer(t, s, r.ok, v.trim(), t.answer, r.msg); return; }
  if(t.type === 'multi'){ const sel = s.tmp.sel.slice().sort((a, b) => a - b); if(!sel.length) return;
    const right = t.opts.map((o, i) => o.ok ? i : -1).filter(i => i >= 0), ok = sel.length === right.length && sel.every((v, i) => v === right[i]);
    answer(t, s, ok, sel.map(i => t.opts[i].t).join('; '), right.map(i => t.opts[i].t).join('; '), t.explain, {sel}); return; }
  if(t.type === 'order'){ const seq = s.tmp.seq.slice(); if(!seq.length) return; const got = seq.map(i => t.pieces[i]);
    answer(t, s, got.join('\\') === t.right.join('\\'), got.join('\\'), t.right.join('\\'), t.explain, {seq}); }
}
document.addEventListener('click', e => {
  const b = e.target.closest('button'); if(!b) return;
  const d = b.dataset, s = S.ses[S.cur], t = s && !s.done ? s.tasks[s.i] : null;
  if(d.go){ S.cur = d.go; if(chOf(d.go) && !S.ses[d.go]) newSession(d.go); render(); window.scrollTo(0, 0); return; }   /* переход между разделами ничего не сбрасывает; новые задания — только кнопкой «Ещё раз» */
  if(d.mode){ S.mode[S.cur] = d.mode; render(); window.scrollTo(0, 0); return; }                              /* вкладки — только вид, без сброса */
  if(d.again){ newSession(S.cur); render(); return; }
  if(d.save){ saveReport(); return; }
  if(d.next){ if(s.i + 1 < TOTAL){ s.i++; s.answered = false; s.fb = null; s.tmp = freshTmp(); } else finish(S.cur); render(); return; }
  if(!t || s.answered) return;
  if(d.opt !== undefined){ const i = +d.opt, o = t.opts[i], txt = x => t.raw ? plain(x.t) : x.t; answer(t, s, o.ok, txt(o), txt(t.opts.find(x => x.ok)), t.explain, {pick:i}); return; }
  if(d.tog !== undefined){ const i = +d.tog, k = s.tmp.sel.indexOf(i); if(k < 0) s.tmp.sel.push(i); else s.tmp.sel.splice(k, 1); render(); return; }
  if(d.ch !== undefined){ const i = +d.ch, ch = [...t.name][i]; answer(t, s, BADCH.includes(ch), 'символ ' + ch, 'символ ' + [...t.name].filter(c => BADCH.includes(c))[0], t.explain, {pick:i}); return; }
  if(d.piece !== undefined){ s.tmp.seq.push(+d.piece); render(); return; }
  if(d.reset){ s.tmp.seq = []; render(); return; }
  if(d.node !== undefined){ const i = +d.node, ns = nodes(t.tree), n = ns[i], r = ns[t.right]; const lab = x => (x.k === 'f' ? 'файл ' : 'папка ') + pathStr(t.tree.d, x.path, x.name);
    answer(t, s, i === t.right, lab(n), lab(r), t.explain, {pick:i}); return; }
  if(d.check){ check(); }
});
document.addEventListener('keydown', e => { if(e.key === 'Enter' && e.target.id === 'ans'){ e.preventDefault(); check(); } });
['fio','cls'].forEach(id => $(id).addEventListener('input', () => $(id).classList.remove('need')));

/* ================= ОТЧЁТ ================= */
function saveReport(){
  const fio = $('fio').value.trim().replace(/\s+/g,' '), cls = $('cls').value.trim().replace(/\s+/g,' ');
  $('fio').classList.toggle('need', !fio); $('cls').classList.toggle('need', !cls);
  if(!fio || !cls){ $('warn').classList.remove('hide'); (fio ? $('cls') : $('fio')).focus(); return; }
  $('warn').classList.add('hide');
  const d = new Date(), p2 = n => String(n).padStart(2,'0');
  const when = p2(d.getDate()) + '.' + p2(d.getMonth() + 1) + '.' + d.getFullYear() + ' ' + p2(d.getHours()) + ':' + p2(d.getMinutes());
  const t = totals(), L = [];
  L.push('ОТЧЁТ УЧЕНИКА', 'Тема: Файловая система и программное обеспечение (6 класс)', '', 'Фамилия, имя: ' + fio, 'Класс: ' + cls, 'Дата и время: ' + when, '', 'РЕЗУЛЬТАТЫ ПО РАЗДЕЛАМ (из 10)', '----------------------------------------');
  CH.forEach(c => { const r = S.res[c.id]; L.push(c.n + '. ' + c.title, '   попыток: ' + r.attempts + '; последний результат: ' + (r.last === null ? 'не пройден' : r.last) + '; лучший результат: ' + (r.best === null ? 'не пройден' : r.best)); });
  L.push('----------------------------------------', 'Пройдено разделов: ' + t.done + ' из ' + CH.length, 'Сумма лучших результатов: ' + t.sum + ' из 50', 'ИТОГ: ' + t.mark + ' из 10', '');
  L.push('ОШИБКИ В ПОСЛЕДНЕЙ ПОПЫТКЕ', '----------------------------------------');
  let any = false;
  CH.forEach(c => { const r = S.res[c.id]; if(r.mistakes.length){ any = true; L.push(c.n + '. ' + c.title); r.mistakes.forEach(x => L.push('   - ' + x.q, '     ответ ученика: ' + x.given, '     правильно: ' + x.right)); } });
  if(!any) L.push(t.done ? 'Ошибок нет.' : 'Разделы ещё не пройдены.');
  const safe = s => s.replace(/[\/\\:*?"<>|]/g,'').replace(/\s+/g,'_');
  const blob = new Blob(['\uFEFF' + L.join('\r\n')], {type:'text/plain;charset=utf-8'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'Файлы_и_ПО_' + safe(fio) + '_' + safe(cls) + '.txt';
  document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 500);
}

/* ================= СТАРТ ================= */
$('fio').value = ''; $('cls').value = '';
newSession('ch1'); render();
</script>

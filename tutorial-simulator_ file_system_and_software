    <div class="r" style="padding-left:3.2rem"><svg class="ic"><use href="#i-folder"/></svg>История</div>
    <div class="r" style="padding-left:4.8rem"><svg class="ic file"><use href="#i-file"/></svg>Доклад.docx</div>
